generator client {
provider = "prisma-client-js"
}

datasource db {
provider = "postgresql"
url      = env("DATABASE_URL")
}

enum CollegeStatus {
PENDING
APPROVED
REJECTED
}

model User {
id                 String          @id @default(cuid())
email              String          @unique
name               String?
image              String?
createdAt          DateTime        @default(now())
emailVerified      DateTime?
isAdmin            Boolean         @default(false)
accounts           Account[]
collegeSubmissions College[]
sessions           Session[]
profile            StudentProfile?
}

model Account {
id                String  @id @default(cuid())
userId            String
type              String
provider          String
providerAccountId String
refresh_token     String?
access_token      String?
expires_at        Int?
token_type        String?
scope             String?
id_token          String?
session_state     String?
user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

@@unique([provider, providerAccountId])
}

model Session {
id           String   @id @default(cuid())
sessionToken String   @unique
userId       String
expires      DateTime
user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
identifier String
token      String   @unique
expires    DateTime

@@unique([identifier, token])
}

model College {
id            String           @id @default(cuid())
name          String
website       String
emailDomain   String?
city          String?
state         String?
country       String           @default("India")
status        CollegeStatus    @default(PENDING)
submittedById String
createdAt     DateTime         @default(now())
updatedAt     DateTime         @updatedAt
submittedBy   User             @relation(fields: [submittedById], references: [id])
faculty       Faculty[]
rooms         GossipRoom[]
incidents     Incident[]
stories       Story[]
students      StudentProfile[]
}

model StudentProfile {
id             String   @id @default(cuid())
userId         String   @unique
displayName    String?
course         String?
graduationYear Int?
collegeId      String?
createdAt      DateTime @default(now())
updatedAt      DateTime @updatedAt
college        College? @relation(fields: [collegeId], references: [id])
user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Faculty {
id               String   @id @default(cuid())
name             String
designation      String?
department       String?
experience       String?
researchInterest String?
profileUrl       String?  @unique
createdAt        DateTime @default(now())
collegeId        String?
college          College? @relation(fields: [collegeId], references: [id])
ratings          Rating[]
}

model Rating {
id              String         @id @default(cuid())
facultyId       String
teachingClarity Int
approachability Int
gradingFairness Int
punctuality     Int
partiality      Int
behaviour       Int
review          String?
ratingHash      String         @unique
createdAt       DateTime       @default(now())
flagged         Boolean        @default(false)
faculty         Faculty        @relation(fields: [facultyId], references: [id])
reports         RatingReport[]
}

model RatingReport {
id         String   @id @default(cuid())
ratingId   String
reportHash String   @unique
createdAt  DateTime @default(now())
rating     Rating   @relation(fields: [ratingId], references: [id], onDelete: Cascade)
}

model Incident {
id        String           @id @default(cuid())
content   String
category  String
upvotes   Int              @default(0)
userHash  String
createdAt DateTime         @default(now())
expiresAt DateTime
hidden    Boolean          @default(false)
collegeId String?
college   College?         @relation(fields: [collegeId], references: [id])
reports   IncidentReport[]
}

model IncidentReport {
id         String   @id @default(cuid())
incidentId String
reportHash String   @unique
createdAt  DateTime @default(now())
incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
}

model GossipRoom {
id          String          @id @default(cuid())
name        String
roomCode    String          @unique
password    String
creatorHash String
createdAt   DateTime        @default(now())
collegeId   String?
messages    GossipMessage[]
college     College?        @relation(fields: [collegeId], references: [id])
}

model GossipMessage {
id        String     @id @default(cuid())
roomId    String
content   String
userHash  String
createdAt DateTime   @default(now())
room      GossipRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Story {
id        String         @id @default(cuid())
title     String
content   String
userHash  String
collegeId String
upvotes   Int            @default(0)
hidden    Boolean        @default(false)
createdAt DateTime       @default(now())
college   College        @relation(fields: [collegeId], references: [id])
comments  StoryComment[]
reports   StoryReport[]
}

model StoryComment {
id        String   @id @default(cuid())
storyId   String
content   String
userHash  String
upvotes   Int      @default(0)
createdAt DateTime @default(now())
story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
}

model StoryReport {
id         String   @id @default(cuid())
storyId    String
reportHash String   @unique
createdAt  DateTime @default(now())
story      Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
}
