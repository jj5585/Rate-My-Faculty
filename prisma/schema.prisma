generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  image          String?
  emailVerified  DateTime?   // 👈 THIS FIXES YOUR ERROR
  createdAt      DateTime @default(now())
  accounts       Account[]
  sessions       Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Faculty {
  id               String   @id @default(cuid())
  name             String
  designation      String?
  department       String?
  experience       String?
  researchInterest String?
  photoUrl         String?
  profileUrl       String   @unique
  createdAt        DateTime @default(now())
  ratings          Rating[]
}

model Rating {
  id               String   @id @default(cuid())
  facultyId        String
  faculty          Faculty  @relation(fields: [facultyId], references: [id])
  teachingClarity  Int
  approachability  Int
  gradingFairness  Int
  punctuality      Int
  partiality       Int
  behaviour        Int
  review           String?
  ratingHash       String   @unique
  createdAt        DateTime @default(now())
}